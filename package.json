{
  "name": "chronicle-odds-derivatives",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:oracle": "hardhat test test/OddsIndexOracle.ts",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/Chronicle.ts --network localhost --deployment-id chronicle-local",
    "deploy:arc": "hardhat ignition deploy ignition/modules/ChronicleArc.ts --network arcTestnet --deployment-id chronicle-arc",
    "setup:arc-demo": "hardhat run scripts/arc-demo-setup.ts --network arcTestnet",
    "settle:arc-demo": "hardhat run scripts/arc-demo-settle.ts --network arcTestnet",
    "smoke:local": "hardhat run scripts/local-smoke.ts --network localhost",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "typecheck": "hardhat build && tsc --noEmit",
    "check": "hardhat test && tsc --noEmit && pnpm --dir web build",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.7.5",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.11.1",
    "mocha": "11.7.6",
    "typescript": "^5.9.3"
  }
}
