# ─────────────────────────────────────────────────────────────
# Circle Arc testnet — frontend config
# ─────────────────────────────────────────────────────────────
# Copy this file to web/.env once contracts are deployed to Arc:
#   cp web/.env.arc.example web/.env
# then fill in the four contract addresses printed by the Arc deploy
# (ignition/deployments/chronicle-arc/deployed_addresses.json).
#
# Every value here is read by web/src/config.ts — nothing about the
# chain is hardcoded in the app.

# --- Arc testnet network (get exact values from Circle Arc docs/portal) ---
VITE_CHAIN_ID=REPLACE_WITH_ARC_CHAIN_ID
VITE_CHAIN_NAME=Circle Arc Testnet
VITE_RPC_URL=https://REPLACE_WITH_ARC_TESTNET_RPC

# --- Deployed contract addresses (fill after `pnpm deploy:arc`) ---
VITE_USDC_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_POOL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_OPTION_ADDRESS=0x0000000000000000000000000000000000000000

# MockUSDC is deployed on Arc testnet, so the in-app faucet stays enabled.
VITE_ENABLE_FAUCET=true
